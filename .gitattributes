# Plugin release bytes feed reviewed-tree and ZIP SHA-256 values. Keep text
# checkout bytes stable across core.autocrlf settings and preserve sprite bytes.
/plugins/**/*.js text eol=lf
/plugins/**/*.json text eol=lf
/plugins/**/*.md text eol=lf
/plugins/**/*.svg text eol=lf
/plugins/**/.openpets-approved-hosts text eol=lf
/plugins/**/*.webp binary

# Native wake build-input digests must be identical across target OS checkouts.
/apps/desktop/wake-helper/** text eol=lf
/apps/desktop/src/voice-wake-*.ts text eol=lf
